{
  "name": "portfolio-mcp",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone MCP server for managing the Supabase-backed portfolio engineering blog.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:http": "tsx watch src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
