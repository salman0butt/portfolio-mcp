# Supabase project used by the portfolio blog.
# Prefer the modern server-side secret key (sb_secret_...). Never expose it to ChatGPT or a browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_BLOG_BUCKET=blog-images

# Remote HTTP MCP authentication. Generate different random values for each (32+ characters).
PORTFOLIO_MCP_TOKEN=replace-with-long-random-bearer-token
PORTFOLIO_MCP_URL_TOKEN=replace-with-different-long-random-url-token

# HTTP server
PORT=3000
HOST=0.0.0.0
MCP_ALLOWED_ORIGINS=*
# 5 MiB request ceiling; enough for a 3 MiB decoded image plus base64/JSON overhead.
MCP_MAX_REQUEST_BYTES=5242880
