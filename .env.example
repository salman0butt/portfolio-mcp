# Supabase project used by the portfolio blog
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_BLOG_BUCKET=blog-images

# Remote HTTP MCP authentication. Generate different random values for each.
PORTFOLIO_MCP_TOKEN=replace-with-long-random-bearer-token
PORTFOLIO_MCP_URL_TOKEN=replace-with-different-long-random-url-token

# HTTP server
PORT=3000
HOST=0.0.0.0
MCP_ALLOWED_ORIGINS=*
